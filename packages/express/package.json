{
  "name": "@dispatchitapp/express",
  "version": "1.0.0",
  "description": "Express error-handler middleware for Dispatch — auto-captures unhandled route errors with request context.",
  "license": "MIT",
  "author": "Dispatch Team <hello@dispatchit.app>",
  "homepage": "https://dispatchit.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recursivity-LLC/dispatch-sdks.git",
    "directory": "packages/express"
  },
  "bugs": "https://github.com/Recursivity-LLC/dispatch-sdks/issues",
  "keywords": ["error-tracking", "express", "middleware", "dispatch", "monitoring"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dispatchitapp/node": "workspace:*"
  },
  "devDependencies": {
    "@dispatchitapp/core": "workspace:*",
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
