{
  "name": "@dispatch/browser",
  "version": "1.0.0-alpha.0",
  "description": "Browser error tracker for Dispatch: cross-browser stack parsing, breadcrumbs, user path, and a fetch-keepalive/sendBeacon transport.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dispatch/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^14.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
