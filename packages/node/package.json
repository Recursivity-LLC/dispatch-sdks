{
  "name": "@dispatchitapp/node",
  "version": "1.0.0",
  "description": "Node.js server SDK for Dispatch: global error handlers, V8 stack frames with source context, on top of @dispatchitapp/core.",
  "license": "MIT",
  "author": "Dispatch Team <hello@dispatchit.app>",
  "homepage": "https://dispatchit.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recursivity-LLC/dispatch-sdks.git",
    "directory": "packages/node"
  },
  "bugs": "https://github.com/Recursivity-LLC/dispatch-sdks/issues",
  "keywords": ["error-tracking", "monitoring", "dispatch", "nodejs", "sentry"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dispatchitapp/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
