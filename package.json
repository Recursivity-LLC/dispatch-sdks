{
  "name": "dispatch-sdks",
  "private": true,
  "version": "0.0.0",
  "description": "Client SDKs for Dispatch — contract-first monorepo",
  "license": "MIT",
  "homepage": "https://dispatchit.app",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "conformance": "pnpm --filter @dispatchitapp/conformance test",
    "contract:validate": "pnpm --filter @dispatchitapp/contract validate"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
